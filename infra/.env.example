# Postgres
POSTGRES_USER=pecuaria
POSTGRES_PASSWORD=pecuaria
POSTGRES_DB=pecuaria
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# MinIO (S3-compatible)
MINIO_ROOT_USER=pecuaria
MINIO_ROOT_PASSWORD=pecuaria123
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=pecuaria-rasters

# API (apps/api) — CELERY_BROKER_URL e usado pelo producer que enfileira
# tasks do worker (ex.: reavaliar representatividade), sem importar o worker.
DATABASE_URL=postgresql+psycopg://pecuaria:pecuaria@localhost:5432/pecuaria
API_PORT=8000
CELERY_BROKER_URL=redis://localhost:6379/0

# Worker (workers/geo) — usa o mesmo DATABASE_URL da API (acesso via
# SQLAlchemy Core/tabelas refletidas, sem importar os models da API)
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Web (apps/web)
VITE_API_BASE_URL=http://localhost:8000
