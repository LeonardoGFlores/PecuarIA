# Copie este arquivo para server/.env e preencha o que estiver disponível.
# Toda fonte sem credenciais configuradas fica com status "not_configured"
# em vez de falhar ou inventar dados.

# Porta do servidor Express
PORT=3001

# Agente interno de análise (Anthropic Claude API)
# https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Google Programmable Search Engine (Custom Search JSON API)
# https://programmablesearchengine.google.com/  |  https://console.cloud.google.com/apis
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# Instagram Graph API — Business Discovery
# Exige uma conta comercial/criador própria conectada a um App do Meta.
# https://developers.facebook.com/docs/instagram-api/guides/business-discovery
IG_BUSINESS_ACCOUNT_ID=
IG_ACCESS_TOKEN=

# Facebook Graph API — busca e leitura de Páginas públicas
# https://developers.facebook.com/docs/graph-api/
FB_ACCESS_TOKEN=
